# ─── FutureX 环境变量模板 ──────────────────────────────
# 复制此文件为 .env 并填入真实值
# ⚠️  包含密钥，切勿提交到 Git

# ─── App ────────────────────────────────────────────────
# 前端 API 地址（生产环境设为后端实际 URL）
# 开发环境无需设置，默认 http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Supabase ───────────────────────────────────────────
# 从 Supabase Dashboard → Settings → Database → Connection string 获取
# 格式: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="your_pooled_connection_string"

# 直连 URL（用于 Prisma 迁移）
# 格式: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL="your_direct_connection_string"

# ─── Mock Mode ──────────────────────────────────────────
# true  = 使用内存数据（无需数据库）
# false = 使用 Supabase
MOCK_MODE=false

# ─── JWT ────────────────────────────────────────────────
# 生成命令: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-change-me"

# ─── Server ─────────────────────────────────────────────
PORT=4000
